# Dedicated Lab settings only. Never copy the IDRAK production env file here.
# Set real values only in the hosting provider's secret settings, never in Git.
IDRAK_LAB_ISOLATED_DATABASE=yes
IDRAK_LAB_DATABASE_URL=
IDRAK_LAB_ACCESS_USER=lab
# Random, at least 20 characters.
IDRAK_LAB_ACCESS_PASSWORD=
# Random, at least 32 characters, distinct from every other secret here.
# Signs webhooks and browser sessions, and derives each shop's webhook key that
# pairing hands to IDRAK. The Lab refuses to start (and to pair) without it.
# Do not rotate it after shops are paired: their webhook keys would stop matching.
IDRAK_LAB_WEBHOOK_SECRET=
# Optional; pairing is disabled (503) while empty.
# Random, at least 32 characters. Must be IDENTICAL to IDRAK_LAB_PAIRING_KEY on
# the IDRAK API that pairs with this Lab, and different from
# IDRAK_LAB_WEBHOOK_SECRET and IDRAK_LAB_ACCESS_PASSWORD. Use a different value
# for a staging Lab than for the published Lab, so their requests never cross.
IDRAK_LAB_PAIRING_KEY=
# Optional; linking by redirect ("Continue to your POS") is disabled (503) while empty.
# The exact IDRAK web origin owners are sent back to after approving, e.g.
# https://idrak-web-staging.vercel.app (HTTPS, no path). Never taken from a request.
IDRAK_CONNECT_RETURN_ORIGIN=
# Optional; automatic sync. When set, the Lab tells IDRAK right after each sale of a
# PAIRED shop (signed with that shop's key, no sales data), and IDRAK pulls the
# changes. Exact HTTPS address, fixed path, e.g.
# https://api.idrak.online/integrations/lab/notify. Unset -> never sends anything.
IDRAK_CONNECT_NOTIFY_URL=
