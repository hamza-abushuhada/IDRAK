# IDRAK Connect Lab — example configuration (NON-SECRET, local test only).
# Copy to `.env` only to override defaults. The demo server also reads these as
# environment variables. NEVER put real secrets, passwords, API keys, JWTs or
# production settings in this file or in `.env`.

# Ports the simulator listens on (localhost only).
IDRAK_LAB_SOURCE_PORT=8765
IDRAK_LAB_RECEIVER_PORT=8766

# Where the simulator keeps its OWN isolated SQLite test data (created on first run).
# Never point this at any production database.
IDRAK_LAB_DATA_DIR=./data

# Local demo HMAC key for signed webhooks. This is a PUBLIC local-test value (it is
# also the default in demo_server.py). Change it — and set the SAME value on the IDRAK
# side (IDRAK_LAB_WEBHOOK_SECRET) — for any non-local use.
IDRAK_LAB_WEBHOOK_SECRET=idrak-local-demo-only-secret
